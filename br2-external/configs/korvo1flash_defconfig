# Generated by scripts/mkdefconfigs.sh.  Do not edit: change
# common.fragment, headless-iot.fragment, flashroot.fragment and korvo1flash.fragment in br2-external/board/esp32s31/defconfig/.
# Common architecture, kernel, init and build plumbing.  Existing full
# profiles add userspace-full.fragment; korvo1flash adds headless-iot.fragment.
# RV32 IMAC with Zba, Zbb and Zbs, Sv32, soft-float ilp32 by default.
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_32=y
BR2_RISCV_USE_MMU=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
# BR2_RISCV_ISA_RVF is not set
# BR2_RISCV_ISA_RVD is not set
BR2_RISCV_ISA_EXTRA="zba_zbb_zbs"
BR2_RISCV_ABI_ILP32=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_CCACHE=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.3"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_ESP32S31_PATH)/../linux/patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
# The actual file is selected by kernel-default.fragment or korvo1flash.
# CONFIG_BUILTIN_DTB, so the loader copies only one file.
BR2_LINUX_KERNEL_IMAGE=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_7_1=y
BR2_LINUX_KERNEL_EXT_ESP_HOSTED_LINUX=y

BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_HOSTNAME="esp32s31"
BR2_TARGET_GENERIC_ISSUE="ESP32-S31 Linux"
BR2_TARGET_GENERIC_ROOT_PASSWD="korvo-bringup"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/busybox.fragment"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /sbin/serial-autologin"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ESP32S31_PATH)/patches"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/post-image.sh"
# BR2_TARGET_ROOTFS_TAR is not set
# Small wired/Bluetooth userspace for korvo1flash[f].
# WPA/OpenSSL/curl/CA/Lua/iw do not fit the 4 MiB first profile.  Wi-Fi is a
# later larger-variant feature, not a hidden default or a claimed capability.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_IPERF3=y

# Hosted HCI/BR/EDR/BLE.  bluetoothd and D-Bus remain on-demand in post-build.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO is not set
# The root in the flash, for the module alone (esp32s31), which has no
# disk.  The root is a squashfs, with a UBIFS overlay that keeps all
# changes (overlay-init).  The flash is small, so these builds are lean.
# The read-only root on the flash.  Small blocks keep the decompression
# cache of the kernel small.  zstd with the extreme setting makes the image
# smaller than gzip, and it decompresses faster than xz.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_32K=y
# flash_erase resets the overlay to the image.  overlay-init needs
# ubiattach and ubimkvol.  The NOR flash needs no NAND or other UBI tools.
BR2_PACKAGE_MTD=y
# BR2_PACKAGE_MTD_FLASH_LOCK is not set
# BR2_PACKAGE_MTD_FLASH_UNLOCK is not set
# BR2_PACKAGE_MTD_MTD_DEBUG is not set
# BR2_PACKAGE_MTD_NANDDUMP is not set
# BR2_PACKAGE_MTD_NANDTEST is not set
# BR2_PACKAGE_MTD_NANDWRITE is not set
# BR2_PACKAGE_MTD_UBIBLOCK is not set
# BR2_PACKAGE_MTD_UBICRC32 is not set
# BR2_PACKAGE_MTD_UBIDETACH is not set
# BR2_PACKAGE_MTD_UBIFORMAT is not set
# BR2_PACKAGE_MTD_UBIHEALTHD is not set
# BR2_PACKAGE_MTD_UBINFO is not set
# BR2_PACKAGE_MTD_UBINIZE is not set
# BR2_PACKAGE_MTD_UBIRENAME is not set
# BR2_PACKAGE_MTD_UBIRMVOL is not set
# BR2_PACKAGE_MTD_UBIRSVOL is not set
# BR2_PACKAGE_MTD_UBIUPDATEVOL is not set
# ESP32-S31-Korvo-1 without X or SD: a Buildroot/musl root in SPI flash.
# Keep BlueZ and the other small common tools, but do not inherit the desktop
# overlays or their prebuilt soft-float binaries.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay $(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay-flashroot $(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay-korvo1flash"
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/linux-korvo1-flash.config"
BR2_ROOTFS_POST_SCRIPT_ARGS="headless-flash"

# Audio preparation only: retain the library and kernel codec/ASoC support,
# but no useless player/mixer while the I2S DAI is absent.  The DTS has no
# codec or sound-card node, so this phase cannot initialize the ES8389/PA.
BR2_PACKAGE_ALSA_LIB=y
# BR2_PACKAGE_ALSA_LIB_RAWMIDI is not set
# BR2_PACKAGE_ALSA_LIB_HWDEP is not set
# BR2_PACKAGE_ALSA_LIB_SEQ is not set
# BR2_PACKAGE_ALSA_LIB_UCM is not set
# BR2_PACKAGE_ALSA_LIB_OLD_SYMBOLS is not set
# BR2_PACKAGE_ALSA_LIB_TOPOLOGY is not set
