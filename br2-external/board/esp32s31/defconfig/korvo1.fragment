# A web browser and a chat client for the tmux desktop of the upstream
# v0.7 line; evtest for the touch controller (hardware I2C now).  BusyBox
# has i2cdetect, i2cget and i2ctransfer.
BR2_PACKAGE_LYNX=y
BR2_PACKAGE_IRSSI=y
