# tmux from diskroot.fragment with a status bar, and a web browser and a
# chat client for it.
BR2_PACKAGE_LYNX=y
BR2_PACKAGE_IRSSI=y
# evtest for the touch controller.  BusyBox has i2cdetect, i2cget and
