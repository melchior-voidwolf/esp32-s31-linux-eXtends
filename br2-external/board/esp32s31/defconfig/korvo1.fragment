
# ESP32-S31-Korvo-1, with the ESP32-S31-WROOM-3-N16R16V module: root on the
# microSD card.  The card has room, so this build has the full set of
# workstation and debugging tools.
#
# gdbserver needs the C++ runtime.  The full debugger stays in the container.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_GDB=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay $(BR2_EXTERNAL_ESP32S31_PATH)/../local-overlay"
# A login on the panel.
BR2_ROOTFS_POST_SCRIPT_ARGS="tty1"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_PACKAGE_HOST_GENIMAGE=y

# The root is on a removable card, and a clean shutdown is not certain.
BR2_PACKAGE_E2FSPROGS=y
# fsck.fat clears the dirty flag of p1 after a reset.  S10sdcard runs it
# when the cluster count of p1 fits in the free memory.
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
# Dropbear has no SFTP server.  scp of OpenSSH 9 and sftp need one.
BR2_PACKAGE_GESFTPSERVER=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_FASTFETCH=y
# Buildroot and strace 7.1 do not support RV32, so br2-external has a port.
BR2_PACKAGE_STRACE_RV32=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_GPM=y
# Links needs OpenSSL and the CA certificates for HTTPS after the board
# clock is set.
BR2_PACKAGE_LINKS=y
BR2_PACKAGE_LINKS_GRAPHICS=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_MICROPYTHON=y
# An access point with all features, next to the AP mode of wpa_supplicant.
BR2_PACKAGE_HOSTAPD=y
# The BlueZ tools and the deprecated ones (hciconfig, hcitool, hcidump).
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y

# X11 on the framebuffer and a minimal matchbox desktop.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXRENDER=y
BR2_PACKAGE_XLIB_LIBXT=y
BR2_PACKAGE_XLIB_LIBXMU=y
BR2_PACKAGE_XLIB_LIBXPM=y
BR2_PACKAGE_XLIB_LIBXAW=y
BR2_PACKAGE_XAPP_XCURSOR-GEN=n
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_XFONT_FONT_MISC_MISC=y
BR2_PACKAGE_XFONT_FONT_CURSOR_MISC=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_PIXMAN=y
BR2_PACKAGE_LIBERATION=y
BR2_PACKAGE_MATCHBOX=y
BR2_PACKAGE_MATCHBOX_PANEL=y
BR2_PACKAGE_MATCHBOX_DESKTOP=y
BR2_PACKAGE_MATCHBOX_COMMON=y
BR2_PACKAGE_TS_LIB=y
BR2_PACKAGE_XAPP_XSET=y

# Desktop upgrade: IceWM replaces matchbox as the window manager; matchbox
# stays for now as the fallback.  USB keyboard/mouse via evdev (the GT1151
# touch has no Linux I2C driver yet).  Lightweight tools, no GTK2.
BR2_PACKAGE_ICEWM=y
BR2_PACKAGE_DMENU=y
# slang makes mc use --with-screen=slang; the ncurses build of mc 4.8.33
# fails its ncursesw detection and then hits implicit-declaration errors
# with GCC 15.
BR2_PACKAGE_SLANG=y
BR2_PACKAGE_MC=y
BR2_PACKAGE_XAPP_XEDIT=y
BR2_PACKAGE_FEH=y
# evdev needs libudev at build time; switch /dev from plain devtmpfs to eudev.
# Also gives Xorg working AutoAddDevices for hotplugged USB mice/keyboards.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
# PPA/DMA2D-accelerated Xorg driver (EXA Solid/Copy) from ppa-work/.
BR2_PACKAGE_XDRIVER_XF86_VIDEO_S31=y
# Desktop clock + jump-scrolling terminal ergonomics.
BR2_PACKAGE_XAPP_XCLOCK=y
# Tiny animation demos to eyeball desktop smoothness and input latency:
# ico (bouncing wireframe), xdbedizzy (spinning pattern, double-buffered),
# xeyes (follows the pointer).
BR2_PACKAGE_XAPP_ICO=y
BR2_PACKAGE_XAPP_XDBEDIZZY=y
BR2_PACKAGE_XAPP_XEYES=y
