# Small wired/Bluetooth userspace for korvo1flash[f].
# WPA/OpenSSL/curl/CA/Lua/iw do not fit the 4 MiB first profile.  Wi-Fi is a
# later larger-variant feature, not a hidden default or a claimed capability.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_IPERF3=y

# Hosted HCI/BR/EDR/BLE.  bluetoothd and D-Bus remain on-demand in post-build.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO is not set
