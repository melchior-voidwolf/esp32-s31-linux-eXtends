# ESP32-S31-Korvo-1 config: MMU (Sv32), S-mode, no XIP.
# linux-esp32s31.fragment and linux-coreboard1.fragment change it for the
# esp32s31 and coreboard1 boards.
# The loader copies the Image to the cached PSRAM aperture at 0x50000000.
# OpenSBI fw_jump starts it there in S-mode.  The built-in DTB describes the
# SoC.  Buildroot reads this file directly, so it is not in the kernel tree or
# the patch series.  Edit with "make kernel-menuconfig" and save with
# "make kernel-saveconfig".
# CONFIG_RISCV_M_MODE is not set
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x50000000
CONFIG_NONPORTABLE=y
CONFIG_EXPERT=y
# CONFIG_CLINT_TIMER is not set

# CONFIG_CPU_ISOLATION is not set
# 8 KiB of log.
CONFIG_LOG_BUF_SHIFT=13
# Smaller core tables, for a machine with 16 MiB.  The board cannot suspend,
# and no driver here uses hwmon.
CONFIG_BASE_SMALL=y
# CONFIG_SUSPEND is not set
# CONFIG_HWMON is not set
# OpenWrt flash bring-up: embed the flash-init diagnostic initramfs
# (openwrt/esp32s31/flash-init-rootfs).  If the squashfs mount succeeds it
# switch_roots into the real rootfs; on failure it prints the mount errno.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/home/kail/esp32-S31/openwrt/esp32s31/flash-init-rootfs"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable large syscalls and features.  Keep FUTEX, EPOLL, TIMERFD, EVENTFD
# and SIGNALFD: threads and event loops need them, and they are small.
# bluetoothd stops at once without signalfd.
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_FHANDLE is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_KALLSYMS is not set
# CONFIG_VM_EVENT_COUNTERS is not set
# CONFIG_COMPAT_BRK is not set

CONFIG_SLUB_TINY=y

# SysV IPC gives userspace shared memory, message queues and semaphores.
CONFIG_SYSVIPC=y

# /run and /tmp use tmpfs.  musl shared memory and named semaphores use it
# at /dev/shm.
CONFIG_TMPFS=y

# S05swap.sh swaps to /dev/zram0 (LZ4 in RAM) first, then to p3 of the disk.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# RISC-V 32-bit
CONFIG_ARCH_RV32I=y
CONFIG_SOC_ESP32S31=y

# CONFIG_SMP is not set
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
CONFIG_FPU=y

# The console is UART0, on the USB-to-UART bridge.  tty0 shows a copy of the
# kernel log on the LCD, and tty1 has a login.  OpenSBI keeps its UART console
# for firmware messages.  loglevel=5: each line on the panel scrolls the
# uncached frame buffer, which makes the boot slower.  Not quiet: with quiet,
# fbcon does not draw the logo.  The ESP-Hosted driver makes hci0 only when
# it asks for the Bluetooth service.  usbhid.{mouse,kb}poll=8 cap HID
# interrupt polling at 8 ms: behind the high-speed hub every 1 ms poll is a
# split-transaction chain, and together with the 8 kHz SOF it produced
# ~15 kIRQ/s on dwc2 (sy 60-75%, X11 unusable; see patch 0014).
CONFIG_CMDLINE="earlycon=sbi console=tty0 console=ttyS0,115200 loglevel=7 root=1f00 rootfstype=squashfs rootdelay=8 rootwait ro esp32_shm.radio_service=bt"
CONFIG_CMDLINE_FORCE=y

# Fewer timer calls to OpenSBI, and no periodic ticks when idle.
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y

# Built-in DTB, so the loader does not copy a separate DTB.
# The OpenWrt light-AP variant: framebuffer reservation retained, USB at HS.
CONFIG_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB_NAME="espressif/esp32s31_korvo1_openwrt"

# This board has no EFI firmware and no DMI.  riscv enables both by default,
# and they only log that they are absent.
# CONFIG_EFI is not set
# CONFIG_DMI is not set

# 2^8 source-port perturbation entries use 1 KiB.  The default 2^16 uses
# 256 KiB.
CONFIG_INET_TABLE_PERTURB_ORDER=8

# Security (minimal)
# CONFIG_SECCOMP is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_GCC_PLUGINS is not set

# Block layer.  No I/O scheduler: the card is one serial queue, and each
# scheduler request of it gets its own scatterlist of a page, which took
# about 0.5 MiB on the Korvo-1.  Without one, the card was not slower.
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set

# No core dumps.
# CONFIG_COREDUMP is not set

# Devtmpfs, so the kernel makes the /dev nodes.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# S10usb.sh makes mdev the helper for USB sticks.  It starts after the boot
# events, so no process runs for those.
CONFIG_UEVENT_HELPER=y

# Networking.  The ESP-Hosted firmware on hart 0 runs the 802.11 MAC and the
# Bluetooth controller.  Thus cfg80211 is on and mac80211 is off, and the
# built-in ESP-Hosted driver makes wlan0 and hci0.  All
# drivers are built in, so the kernel has no module support.
# udhcpc needs PACKET raw sockets.  INET carries the data.
CONFIG_NET=y
CONFIG_CFG80211=y
# CONFIG_BT is REQUIRED: ESP32S31_HOSTED depends on BT=y
# (drivers/net/wireless/espressif/Kconfig).  Dropping BT makes olddefconfig
# silently erase CONFIG_ESP32S31_HOSTED — no line, no warning (confdata
# visibility trap; same class as MISC_FILESYSTEMS/SQUASHFS).  The kernel
# then has no Wi-Fi and no esp32s31-flash MTD: flash-init waits 20 s for
# /dev/mtdblock0 and reboots forever.  2026-10-24: one BT line costs little
# (the desktop config also carries only BT=y); the hosted driver + flash
# MTD are the entire point of this kernel.
CONFIG_BT=y
CONFIG_ESP32S31_HOSTED=y
# CONFIG_MODULES is not set
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# No tool on the board uses these, and they cost RAM: sock_diag, the ethtool
# netlink interface and IPv6 in IPv4 tunnels.
# CONFIG_INET_DIAG is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_IPV6_SIT is not set

# cfg80211 loads regulatory.db when it registers, before the root is
# mounted, so the file is built in.  Buildroot builds wireless-regdb before
# the kernel.  The path is relative to the kernel source in the Buildroot
# output.  The signature check needs RSA, X.509 and the key code in the
# kernel, so it is off.
CONFIG_EXTRA_FIRMWARE="regulatory.db"
CONFIG_EXTRA_FIRMWARE_DIR="../../target/lib/firmware"
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_ALLOW_DEV_COREDUMP is not set

# USB HID input devices, and the touch controller of the Korvo-1 LCD
# CONFIG_INPUT_EVDEV=y  (dropped: linux-openwrt slim)
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_TOUCHSCREEN=y  (dropped: linux-openwrt slim)
# CONFIG_TOUCHSCREEN_GOODIX=y  (dropped: linux-openwrt slim)
# CONFIG_HID=y  (dropped: linux-openwrt slim)
# CONFIG_HID_GENERIC=y  (dropped: linux-openwrt slim)
# A /dev/hidraw node for each HID interface.  Without it, an interface with
# only vendor reports, such as the HID++ channel of a Logitech receiver, has
# no user, and hid-generic prints "device has no listeners" as an error.
# CONFIG_HIDRAW=y  (dropped: linux-openwrt slim)

# The pin controller, which is also the GPIO controller, so userspace can
# control pins with libgpiod.
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y

# WS2812 RGB LED on the RMT, with triggers for a status LED.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_ESP32S31_WS2812=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
# CONFIG_LEDS_TRIGGER_TIMER=y  (dropped: linux-openwrt slim)
# CONFIG_LEDS_TRIGGER_NETDEV=y  (dropped: linux-openwrt slim)
# Smooth breathing lamp for ledstate (heartbeat is a hard double-blink,
# pattern gives a PWM ramp at zero userspace cost).
CONFIG_LEDS_TRIGGER_PATTERN=y

# I2C for the devices of the boards, with /dev/i2c-N for userspace.  SPI
# is off.
# CONFIG_I2C=y  (dropped: linux-openwrt slim)
# CONFIG_I2C_CHARDEV=y  (dropped: linux-openwrt slim)
# CONFIG_SPI is not set

# USB mass storage
# CONFIG_SCSI=y  (dropped: linux-openwrt slim)
# CONFIG_BLK_DEV_SD=y  (dropped: linux-openwrt slim)
# CONFIG_USB_STORAGE=y  (dropped: linux-openwrt slim)

# USB host
CONFIG_USB=y
CONFIG_USB_DWC2=y
# CONFIG_USB_HID=y  (dropped: linux-openwrt slim)
CONFIG_PHY_ESP32S31_USB=y

# Cache maintenance for DMA.  The hart has no Zicbom, so its ISA support is
# off.  It only adds DMA_DIRECT_REMAP, which cannot make an uncached mapping
# on RV32.
CONFIG_ESP32S31_CACHE=y
# CONFIG_RISCV_ISA_ZICBOM is not set

# MMC/SD card support
# CONFIG_MMC=y  (dropped: linux-openwrt slim)
# CONFIG_MMC_BLOCK=y  (dropped: linux-openwrt slim)
# CONFIG_MMC_DW=y  (dropped: linux-openwrt slim)
# The card power switch is a fixed regulator on a GPIO.
# CONFIG_REGULATOR=y  (dropped: linux-openwrt slim)
# CONFIG_REGULATOR_FIXED_VOLTAGE=y  (dropped: linux-openwrt slim)

CONFIG_NETDEVICES=y
CONFIG_WLAN=y
# USB Ethernet: the USB hub on the desk carries an ASIX AX88772A
# (0b95:772a).  Built-in, like everything else in this kernel.
CONFIG_ETHERNET=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
# CONFIG_USB_NET_AX8817X=y  (dropped: linux-openwrt slim)
# Bridge for br-lan (eth0+wlan0 soft AP shape)
CONFIG_BRIDGE=y
# Realtek RTL8153 USB GigE (Microsoft/Surface 045e:07c6 verified working on
# the build server; no external firmware needed).  For the OpenWrt line's
# WAN/LAN port.
CONFIG_USB_RTL8152=y
# OpenWrt flash firmware: rootfs is a squashfs on the shm_flash MTD.
# MISC_FILESYSTEMS must be y: fs/squashfs/Kconfig lives inside its
# conditional menu, and oldconfig drops SQUASHFS entirely (zero lines)
# when this is unset.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
# XZ_DEC is tristate; SQUASHFS_XZ needs it built-in (rootfs is xz-compressed)
CONFIG_XZ_DEC=y
# Persistent config overlay: OpenWrt's mount_root formats the free space
# after squashfs in the rootfs partition as jffs2 "rootfs_data" (standard
# NOR-router layout).  ~1.2 MiB free in mtd0 after the 2.79 MiB rootfs.
CONFIG_JFFS2_FS=y
CONFIG_OVERLAY_FS=y

# Frame buffer for the 800x480 RGB565 panel of the loader, with fbcon on the
# VTs.  The VT is a printk console, and the command line has console=tty0, so
# the panel shows the kernel warnings and errors.
# CONFIG_FB=y  (dropped: linux-openwrt slim)
# CONFIG_FB_SIMPLE=y  (dropped: linux-openwrt slim)
# CONFIG_FRAMEBUFFER_CONSOLE=y  (dropped: linux-openwrt slim)
# The 224-color Tux at the top of the panel at boot.
# CONFIG_LOGO=y  (dropped: linux-openwrt slim)
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set

# Serial / TTY
# CONFIG_SERIO is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_ESP32=y

# The TRNG of the SoC seeds the CRNG at boot.  Without it, getrandom() blocks
# for approximately 20 seconds while the kernel collects interrupt timing.
CONFIG_HW_RANDOM=y
# CONFIG_HW_RANDOM_TIMERIOMEM=y  (dropped: linux-openwrt slim)
# CONFIG_DEVMEM is not set

# Virtualization I/O is off.
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set

# Filesystems
# CONFIG_DNOTIFY is not set
# CONFIG_EXT4_FS=y  (dropped: linux-openwrt slim)
# CONFIG_VFAT_FS=y  (dropped: linux-openwrt slim)
# CONFIG_NLS_CODEPAGE_437=y  (dropped: linux-openwrt slim)
# CONFIG_NLS_ISO8859_1=y  (dropped: linux-openwrt slim)

# Debug / printk
CONFIG_PRINTK_TIME=y
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
# CONFIG_FRAME_POINTER is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_MISC is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

# Keep the image small: no 4 MB PMD section padding.
# CONFIG_STRICT_KERNEL_RWX is not set

# HW enablement: FPU context switching + /dev/mem for PPA/2D-DMA prototyping
# S31 hart is F-only (rv32imafc); patch 0015 makes the kernel accept
# F-without-D and switches the fstate context switch to fsw/flw.
CONFIG_FPU=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# --- Korvo-1 kernel slim-down (2026-10-24) ---
# The merged v0.7.1 base turned ETHERNET on (for the CoreBoard-1), and
# olddefconfig then defaulted every NET_VENDOR_* family to y: 48 x86-era
# vendor families ended up built into this RV32 kernel (+0.5 MB resident).
# That half megabyte pushed the 10.6 MiB system back into the kswapd
# reclaim livelock.  CoreBoard-1 Ethernet is STMMAC_PLATFORM based and
# does not need any of these families; USB NICs (AX8817X/RTL8152/CDC)
# are unaffected.
# CONFIG_NET_VENDOR_8390 is not set
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_ALIBABA is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_ASIX is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_CADENCE is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_CORTINA is not set
# CONFIG_NET_VENDOR_DAVICOM is not set
# CONFIG_NET_VENDOR_ENGLEDER is not set
# CONFIG_NET_VENDOR_EZCHIP is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_GOOGLE is not set
# CONFIG_NET_VENDOR_HISILICON is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_I825XX is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_LITEX is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_META is not set
# CONFIG_NET_VENDOR_MICREL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_MICROSEMI is not set
# CONFIG_NET_VENDOR_MICROSOFT is not set
# CONFIG_NET_VENDOR_MUCSE is not set
# CONFIG_NET_VENDOR_NATSEMI is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_NI is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_NET_VENDOR_QUALCOMM is not set
# CONFIG_NET_VENDOR_RENESAS is not set
# CONFIG_NET_VENDOR_ROCKER is not set
# CONFIG_NET_VENDOR_SAMSUNG is not set
# CONFIG_NET_VENDOR_SEEQ is not set
# CONFIG_NET_VENDOR_SOCIONEXT is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_STMICRO is not set
# CONFIG_NET_VENDOR_SYNOPSYS is not set
# CONFIG_NET_VENDOR_VERTEXCOM is not set
# CONFIG_NET_VENDOR_VIA is not set
# CONFIG_NET_VENDOR_WANGXUN is not set
# CONFIG_NET_VENDOR_WIZNET is not set
# CONFIG_NET_VENDOR_XILINX is not set
# CONFIG_NET_VENDOR_ZTE is not set
