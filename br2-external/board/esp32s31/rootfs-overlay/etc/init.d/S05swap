#!/bin/sh
# SPDX-License-Identifier: MIT
# Tiered swap for the 11 MiB usable-RAM Korvo-1 (2026-10-22 retune):
#   zram 6M (lz4, prio 100; cap only, pool grows as used)  -- warm anon pages; lz4 beats 10-50 ms SD reads
#   p3 card swap (prio 10)   -- cold idle pages drift here, last resort
# History: the first 6M zram *during the 15 kIRQ/s USB storm* pushed sy+wa
# to 60-100% (fullscreen fill 11 ms -> 879 ms) -- that was the storm's CPU
# bill, not zram's; the cap is a limit, not a reservation, so with the storm
# fixed (patch 0014) 6M costs nothing until used.  The later 2M zram pushed
# the X desktop working set (~14 MB) onto the SD card, whose page-in latency
# livelocked the board (wa 35-50%, shell wedged for minutes) and the PSRAM
# churn even tripped hart0's MSPI error handler -> full system reset.
# swappiness=60 sends anon pages to fast zram before dropping page cache;
# page-cluster=0 disables swap readahead (random reads on the SD card).

ZRAM=/sys/block/zram0
# 12M (2026-10-23): the X desktop working set is ~14 MB against 10.6 MiB
# of physical RAM.  With the 6M cap the anonymous pages filled zram and
# kswapd then reclaimed page cache, so code pages kept streaming back from
# the SD card (wa up to 40%, idle 0, the console unusable).  The pool only
# grows as used and lz4 compresses ~3x, so a bigger cap costs nothing
# until the desktop actually needs it.
ZRAM_SIZE=12M	# uncompressed
CARD=/dev/mmcblk0
CARD_SWAP=${CARD}p3

start_zram()
{
	echo lz4 > $ZRAM/comp_algorithm &&
		echo $ZRAM_SIZE > $ZRAM/disksize &&
		mkswap /dev/zram0 >/dev/null &&
		swapon -p 100 /dev/zram0 &&
		echo "swap: /dev/zram0 ($ZRAM_SIZE, lz4) active"
}

# Only type 0x82 (byte 482 of the MBR) marks p3 as swap: never format other
# data.  mkswap at each boot fits the header to the partition size.
start_card()
{
	[ -b $CARD_SWAP ] || return
	set -- $(dd if=$CARD bs=1 skip=482 count=1 2>/dev/null | od -An -tx1)
	[ "$1" = 82 ] || return
	mkswap $CARD_SWAP >/dev/null &&
		swapon -p 10 $CARD_SWAP &&
		echo "swap: $CARD_SWAP active"
}

case "$1" in
start)
	echo 60 > /proc/sys/vm/swappiness
	echo 0 > /proc/sys/vm/page-cluster
	start_zram
	# p3 card swap stays off: with the desktop working set at ~14 MB and
	# 11 MiB of RAM, anything that lands on the SD card faults back at
	# 10-50 ms per page, which livelocked every desktop boot (wa 35-50%,
	# shell dead for minutes, wpa_supplicant misses auth deadlines).
	# zram-only keeps all swap traffic at sub-ms cost; the zram pool +
	# RAM cover ~23 MB effective, comfortably over the working set.
	# Re-enable manually if a workload needs it: sh -c '. /etc/init.d/S05swap; start_card'
	;;
esac

exit 0
