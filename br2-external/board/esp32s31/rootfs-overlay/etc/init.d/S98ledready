#!/bin/sh
# SPDX-License-Identifier: MIT
# Console is up and no desktop has taken over: rest at the default
# yellow-red heartbeat.  Runs after S95autostart; S99desktop/startde
# override it with green when X is up.
# Default off (webcam glare), same /mnt/sd/RGB opt-in as S02ledstatus.
[ -f /mnt/sd/RGB ] || exit 0
[ "$1" = start ] && /usr/bin/ledstate console
exit 0
